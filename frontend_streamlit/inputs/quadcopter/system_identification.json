{
  "system_name": "Quadcopter",
  "description": "The system describes the dynamics of a quadcopter where the states such as position, velocity, and orientation are controlled by the inputs which are the thrust and torques generated by the rotors.",
  "system_properties": {
    "continuous": "Continuous",
    "linear": "Nonlinear",
    "order": 12,
    "type": "MIMO",
    "n_states": 12,
    "n_inputs": 4
  },
  "inputs": [
    {
      "physical_meaning": "Total thrust generated by the rotors",
      "variable_name": "Thrust",
      "variable_in_equation": "U[0]",
      "unit": "N"
    },
    {
      "physical_meaning": "Roll torque generated by the rotors",
      "variable_name": "Roll Torque",
      "variable_in_equation": "U[1]",
      "unit": "Nm"
    },
    {
      "physical_meaning": "Pitch torque generated by the rotors",
