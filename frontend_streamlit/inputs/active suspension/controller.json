{
  "system_name":"Mass-Spring-Damper System with Uncontrolled Mass",
  "description":"A system with two masses (zs, zu) connected by a spring (ks) and damper (bs), where zs is directly driven by an input force (u) and zu is influenced by an additional damping force (kt*zu), controlled by applying a force u to the first mass.",
  "pid_loops": [
    {
      "loop_name": "inner_velocity_control",
      "controllers": [
        {
          "controlled_variable": "velocity of first mass",
          "controlled_variable_in_equation": "X[1]",
          "setpoint_variable_in_equation": "X_sp[1]",
          "output_signal": "Force command to plant",
          "output_variable_in_equation": "U[0]",
          "output_unit": "N",
          "input_unit": "m/s"
        }
      ]
    },
    {
      "loop_name": "outer_position_control",
      "controllers": [
        {
          "controlled_variable": "position of first mass",
          "controlled_variable_in_equation": "X[0]",
          "setpoint_variable_in_equation": "X_sp[0]",
          "output_signal": "Velocity setpoint for inner loop",
          "output_variable_in_equation": "X_sp[1]",
          "output_unit": "m/s",
          "input_unit": "m"
        }
      ]
    }
  ]
}