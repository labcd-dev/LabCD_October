{
  "system_name":"Chemical Reactor",
  "description":"A continuous chemical reactor with temperature control via coolant temperature, where the controller input (u[0]) adjusts the coolant flow to regulate the reactor's concentration (CA) and temperature (T).",
  "pid_loops": [
    {
      "loop_name": "inner_Tc_control",
      "controllers": [
        {
          "controlled_variable": "Coolant Temperature",
          "controlled_variable_in_equation": "X[2]",
          "controller_output": {
            "is_bounded": true,
            "max_bound": 3.5,
            "min_bound": 0.0,
            "unit": "m^3/s",
            "variable_name": "actuator_command"
          },
          "setpoint_variable_in_equation": "X_sp[2]",
          "output_signal": "actuator_command",
          "output_variable_in_equation": "U[0]",
          "target": {
            "description": "Deduced operational range of this state under typical tracking conditions",
            "max_value": 1.0,
            "min_value": 1.0,
            "unit": "K"
          },
          "output_unit": "m^3/s",
          "input_unit": "K"
        }
      ]
    },
    {
      "loop_name": "middle_T_control",
      "controllers": [
        {
          "controlled_variable": "Reactor Temperature",
          "controlled_variable_in_equation": "X[1]",
          "controller_output": {
            "is_bounded": false,
            "max_bound": "",
            "min_bound": "",
            "unit": "m^3/s",
            "variable_name": "actuator_command"
          },
          "setpoint_variable_in_equation": "X_sp[1]",
          "output_signal": "inner_loop_input",
          "output_variable_in_equation": "X_sp[2]",
          "target": {
            "description": "Deduced operational range of this state under typical tracking conditions",
            "max_value": 2.0,
            "min_value": 2.0,
            "unit": "K"
          },
          "output_unit": "K",
          "input_unit": "K"
        }
      ]
    },
    {
      "loop_name": "outer_CA_control",
      "controllers": [
        {
          "controlled_variable": "Reactor Concentration",
          "controlled_variable_in_equation": "X[0]",
          "controller_output": {
            "is_bounded": false,
            "max_bound": "",
            "min_bound": "",
            "unit": "m^3/s",
            "variable_name": "actuator_command"
          },
          "setpoint_variable_in_equation": "X_sp[0]",
          "output_signal": "inner_loop_input",
          "output_variable_in_equation": "X_sp[1]",
          "target": {
            "description": "Deduced operational range of this state under typical tracking conditions",
            "max_value": 0.05,
            "min_value": 0.05,
            "unit": "mol/m^3"
          },
          "output_unit": "mol/m^3",
          "input_unit": "mol/m^3"
        }
      ]
    }
  ]
}