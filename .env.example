# Copy to .env and fill in the keys you use

# LLM provider: openai | groq | openrouter
LABCD_SYSID_API_PROVIDER=openai
LABCD_SYSID_LLM_MODEL=gpt-4o-mini
LABCD_SYSID_LLM_TEMP=0.5

OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional overrides
# LABCD_SYSID_ARCH=LSTM
# LABCD_SYSID_RUN_MODE=regular
# LABCD_SYSID_DATA=system_data.csv
# LABCD_SYSID_CUSTOMER_DESCRIPTION=Your plant description here
